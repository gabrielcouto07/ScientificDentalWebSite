# Copie para .env.local (desenvolvimento) ou configure nas variáveis de ambiente da Vercel.

# URL pública do site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.scientificdental.com.br

# Google Tag Manager: só carrega depois do aceite de cookies. Deixe vazio para não carregar nada.
NEXT_PUBLIC_GTM_ID=

# Entrega de leads (formulários). Configure um ou os dois canais.
# 1) Webhook genérico: POST JSON com o lead. Serve para RD Station, HubSpot, Zapier, n8n, Make...
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# 2) E-mail via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
LEAD_TO=contato@scientificdental.com.br
LEAD_FROM=site@scientificdental.com.br
